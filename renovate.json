{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alan-turing-institute/rctab//renovate/default"
  ],
  "customManagers": [
    {
      "description": "CI must test on the Python that Azure Functions runs: take the versions offered for setup-python from the Functions base image tags rather than from python.org",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "python-version:\\s*\"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "azure-functions-python",
      "packageNameTemplate": "mcr.microsoft.com/azure-functions/python",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^4-python(?<version>\\d+\\.\\d+)-appservice$",
      "versioningTemplate": "pep440"
    },
    {
      "description": "Build the docs on the same Python as the functions (Read the Docs config)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.readthedocs\\.ya?ml$/"
      ],
      "matchStrings": [
        "python:\\s*\"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "azure-functions-python",
      "packageNameTemplate": "mcr.microsoft.com/azure-functions/python",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^4-python(?<version>\\d+\\.\\d+)-appservice$",
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "description": "Replaced by the azure-functions-python custom manager above",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Read the Python version from the Azure Functions base image tag, e.g. 4-python3.13-appservice",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/azure-functions/python"
      ],
      "versioning": "regex:^4-python(?<major>\\d+)\\.(?<minor>\\d+)-appservice$"
    },
    {
      "description": "Python version bumps (CI and base images) join the preset's python group: one PR, approved from the Dependency Dashboard, never automerged",
      "matchDepNames": [
        "azure-functions-python",
        "mcr.microsoft.com/azure-functions/python"
      ],
      "groupName": "python",
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
